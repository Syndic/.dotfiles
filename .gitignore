# ── macOS ─────────────────────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors ───────────────────────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.coverage

# ── Claude Code ───────────────────────────────────────────────────────────────────────────────────
# settings.local.json holds per-developer overrides — never shared
# worktrees/ is ephemeral scratch space used during development
.claude/settings.local.json
.claude/worktrees/

# ── Codex ───────────────────────────────────────────────────────────────────────────────────
.codex/worktrees/

# ── Python ────────────────────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── Ansible ───────────────────────────────────────────────────────────────────────────────────────
# ansible-lint's project-local cache (it installs requirements.yml collections here)
/.ansible/

# ── Devcontainer host plumbing ────────────────────────────────────────────────────────────────────
# Written on every `devcontainer up` by .devcontainer/initialize.sh. Host-local, never
# tracked; .git-plumbing/ itself is tracked via its README.
/.devcontainer/.host-git-common
/.devcontainer/.host-known-hosts
/.devcontainer/.host-allowed-signers
/.devcontainer/.git-plumbing/host-git-common-path
/.devcontainer/.git-plumbing/host-timezone
/.devcontainer/.git-plumbing/host-gitconfig
/.devcontainer/.git-plumbing/empty-allowed-signers
# TEND(migration): no longer written; ignored until initialize.sh's cleanup has run everywhere.
/.devcontainer/.git-plumbing/host-known-hosts
/.devcontainer/.git-plumbing/host-allowed-signers

# ── Runtime state ─────────────────────────────────────────────────────────────────────────────────
# phase2.py writes this after a successful install so uninstall.py can default
# to the right --host without re-prompting.
/.installed-host
