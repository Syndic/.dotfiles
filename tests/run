#!/usr/bin/env bash
# Run the test suites.
#
#   ./tests/run             # everything (python + bash + lint + molecule)
#   ./tests/run fast        # python + bash + lint (skip molecule — no docker)
#   ./tests/run python      # just pytest
#   ./tests/run bash        # just bats
#   ./tests/run lint        # yamllint + ansible-lint
#   ./tests/run molecule    # just molecule (per-role scenarios; needs docker)
#
# CI runs each suite as its own job — see .github/workflows/tests.yml.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

run_python() {
  echo "=== python ==="
  pytest tests/python -v
}

run_bash() {
  echo "=== bash ==="
  bats tests/bash
}

run_lint() {
  echo "=== lint ==="
  yamllint .
  ansible-lint
}

run_molecule() {
  echo "=== molecule ==="
  # Each scenario lives under roles/<role>/molecule/<scenario>/. molecule
  # discovers them via MOLECULE_GLOB and is invoked from the role dir so
  # `molecule test --all` finds every scenario directory.

  # The homebrew scenarios share a Linuxbrew-preinstalled base image. Build
  # it once before the scenario loop — docker layer caching makes this a
  # near-no-op on rebuild. Followup: replace this local build with a pull
  # from a ghcr-published image (see roles/homebrew/molecule/Dockerfile).
  echo "--- molecule: building roles/homebrew base image ---"
  docker build -t dotfiles-homebrew-molecule:local roles/homebrew/molecule/

  local rc=0
  # `molecule test --all` runs every scenario under the role's molecule/
  # dir. Equivalent to `-s default` for roles with just one scenario, and
  # picks up the multi-scenario homebrew role without per-role special-
  # casing.
  for role_dir in roles/dotfiles roles/apt roles/flatpak roles/homebrew; do
    echo "--- molecule: ${role_dir} ---"
    (cd "${role_dir}" && molecule test --all) || rc=$?
  done
  return $rc
}

case "${1:-all}" in
  python)   run_python ;;
  bash)     run_bash ;;
  lint)     run_lint ;;
  molecule) run_molecule ;;
  fast)     run_python; run_bash; run_lint ;;
  all)      run_python; run_bash; run_lint; run_molecule ;;
  *)        echo "usage: $0 [python|bash|lint|molecule|fast|all]" >&2; exit 2 ;;
esac
