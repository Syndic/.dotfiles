#!/usr/bin/env python3.14
# renovate: datasource=python-version depName=python
"""Run the test suites.

  ./tests/run                  # everything (python + bash + lint + molecule)
  ./tests/run fast             # python + bash + lint (skip molecule — no docker)
  ./tests/run python           # just pytest
  ./tests/run bash             # just bats
  ./tests/run lint             # yamllint + ansible-lint
  ./tests/run molecule         # all molecule roles, serial (needs docker)
  ./tests/run molecule <role>  # one role's scenarios — used by the CI matrix

CI runs each suite as its own job — see .github/workflows/tests.yml. The
molecule job shards across roles via `./tests/run molecule <role>` so wall-
clock is bounded by the slowest shard (homebrew) instead of the sum.

Multi-suite invocations (`all` / `fast`) run every suite in parallel,
buffering each suite's output to a tempfile. On a tty, a live dashboard
shows the last TAIL_LINES (default 20) of each currently-running suite,
refreshed every TICK (default 2) seconds via cursor-up + erase. The
dashboard header uses the announce-style yellow bracket from
_dotfiles_common so it stays visually distinct from pytest/molecule's
own banner-like lines, and tracks `X/N suites complete`. When a suite
finishes, its full buffered output flushes above the dashboard prefixed
with a PASS (yellow) or FAIL (red) announce banner. On a non-tty (CI,
piped) the dashboard is skipped — completed-suite output still flushes
as each finishes; the summary still prints at the end. Exit is non-zero
iff any suite failed.

Tunable via env: TICK=<seconds>, TAIL_LINES=<n>.

Single-suite invocations (`./tests/run python`, etc.) preserve fail-fast
semantics — no parallelism, no summary, exit code propagates directly.

Runs under the same `tooling_python` (3.14) as the lint/molecule CI jobs
and the devcontainer's Ansible venv — *not* the frozen 3.9.6 that drives
the bootstrap. The shebang version is Renovate-tracked alongside the
other two so all three stay in step. This is dev tooling, not bootstrap,
so it gets the latest language features (`match`, `Self`, native union
types, parenthesized context managers).
"""
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Self

# Repo root is two levels up from this script. Add to sys.path so we can
# import the shared output helpers that the bootstrap + uninstall also use,
# keeping the bracket-style colored banners visually consistent across the
# whole repo.
REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from _dotfiles_common import announce, die, info, warn  # noqa: E402

# Tunable via env. Cast at import so bad values surface immediately, not
# partway through a parallel run.
TICK = float(os.environ.get("TICK", "2"))
TAIL_LINES = int(os.environ.get("TAIL_LINES", "20"))

# All molecule-covered roles. New roles with scenarios under
# `roles/<role>/molecule/` must also be added to the `matrix.role` list in
# .github/workflows/tests.yml — local serial runs and CI shard discovery
# read from different sources. test_molecule_role_lists_agree.py asserts
# both lists match what's on disk.
MOLECULE_ROLES = ["dotfiles", "apt", "flatpak", "homebrew"]

# --------------------------------------------------------------------------- #
# ANSI helpers (extending _dotfiles_common's bracket-style banners)
# --------------------------------------------------------------------------- #
ANSI_HIDE_CURSOR = "\x1b[?25l"
ANSI_SHOW_CURSOR = "\x1b[?25h"
ANSI_PASS_BADGE = "\x1b[1;37;42m PASS \x1b[0m"   # white-on-green
ANSI_FAIL_BADGE = "\x1b[1;37;101m FAIL \x1b[0m"  # white-on-red


def announce_fail(msg: str) -> None:
    """Mirror of `_dotfiles_common.announce`, but red — for the completion
    banner of a failing suite so it pops in the scrollback alongside the
    yellow PASS banners."""
    print(f"\n\x1b[1;37;101m {msg} \x1b[0m")


def format_duration(seconds: float) -> str:
    s = int(seconds)
    if s < 60:
        return f"{s}s"
    return f"{s // 60}m {s % 60:02d}s"


# --------------------------------------------------------------------------- #
# Suite definitions
# --------------------------------------------------------------------------- #
@dataclass(frozen=True, slots=True)
class Suite:
    """One named test suite — an argv that runs the whole thing as a single
    subprocess. Multi-command suites (lint, molecule) wrap their commands in
    `bash -c '... && ...'` so they're still one Popen-able invocation."""

    name: str
    argv: list[str]


PYTHON_SUITE = Suite("python", ["pytest", "tests/python", "-v"])
BASH_SUITE = Suite("bash", ["bats", "tests/bash"])
# `&&` so a yamllint failure short-circuits ansible-lint — matches the
# fail-fast behavior of the previous bash version's `set -e`.
LINT_SUITE = Suite("lint", ["bash", "-c", "yamllint . && ansible-lint"])


def molecule_role_suite(role: str) -> Suite:
    return Suite(
        f"molecule:{role}",
        ["bash", "-c", f"cd roles/{role} && molecule test --all"],
    )


# --------------------------------------------------------------------------- #
# Homebrew image prep — runs serially before any parallel spawn
# --------------------------------------------------------------------------- #
def prepare_homebrew_image() -> None:
    """Build or pull the Linuxbrew base image used by every homebrew molecule
    scenario. Lifted out of the molecule shard so parallel `docker build` /
    `docker tag` calls against the same `:local` tag don't race. The
    summary's `molecule:homebrew` wall-clock therefore reflects test work
    only, not image prep.

    MOLECULE_HOMEBREW_IMAGE (set by CI) names a published image to pull and
    retag. On pull failure — registry hiccup, image not yet published, PR
    editing the Dockerfile — fall back to a local docker build so a fresh
    Dockerfile is tested against its own changes."""
    if image := os.environ.get("MOLECULE_HOMEBREW_IMAGE", "").strip():
        info(f"molecule: pulling homebrew base image from {image}")
        try:
            subprocess.run(["docker", "pull", image], check=True, cwd=REPO_ROOT)
            subprocess.run(
                ["docker", "tag", image, "dotfiles-homebrew-molecule:local"],
                check=True,
                cwd=REPO_ROOT,
            )
            return
        except subprocess.CalledProcessError:
            warn("molecule: pull failed; falling back to local build")
    info("molecule: building roles/homebrew base image")
    subprocess.run(
        [
            "docker",
            "build",
            "-t",
            "dotfiles-homebrew-molecule:local",
            "roles/homebrew/molecule/",
        ],
        check=True,
        cwd=REPO_ROOT,
    )


# --------------------------------------------------------------------------- #
# Serial single-suite paths (no dashboard, exit code propagates)
# --------------------------------------------------------------------------- #
def run_single_suite(suite: Suite) -> int:
    return subprocess.call(suite.argv, cwd=REPO_ROOT)


def run_lint_serial() -> int:
    """Two-command suite — run yamllint, short-circuit on failure."""
    if (rc := subprocess.call(["yamllint", "."], cwd=REPO_ROOT)) != 0:
        return rc
    return subprocess.call(["ansible-lint"], cwd=REPO_ROOT)


def run_molecule_role_serial(role: str) -> int:
    if role == "homebrew":
        prepare_homebrew_image()
    info(f"--- molecule: roles/{role} ---")
    return subprocess.call(
        ["bash", "-c", f"cd roles/{role} && molecule test --all"],
        cwd=REPO_ROOT,
    )


def run_molecule(target_role: str | None) -> int:
    info("=== molecule ===")
    if target_role is not None and target_role not in MOLECULE_ROLES:
        die(
            f"unknown molecule role: {target_role} "
            f"(known: {', '.join(MOLECULE_ROLES)})"
        )
    roles = MOLECULE_ROLES if target_role is None else [target_role]
    rc = 0
    for role in roles:
        if (result := run_molecule_role_serial(role)) != 0:
            rc = result
    return rc


# --------------------------------------------------------------------------- #
# Parallel orchestrator
# --------------------------------------------------------------------------- #
@dataclass(slots=True)
class ParallelRunner:
    """Spawns every suite as a subprocess writing to its own tempfile.
    `poll()` returns the names of any newly-completed suites since the last
    poll. `cleanup()` terminates survivors and removes the tempdir."""

    suites: list[Suite]
    tmpdir: Path = field(init=False)
    procs: dict[str, subprocess.Popen] = field(default_factory=dict)
    log_paths: dict[str, Path] = field(default_factory=dict)
    start_times: dict[str, float] = field(default_factory=dict)
    # name -> (rc, elapsed_seconds)
    results: dict[str, tuple[int, float]] = field(default_factory=dict)

    def __post_init__(self) -> None:
        self.tmpdir = Path(tempfile.mkdtemp(prefix="dotfiles-tests-run."))

    def spawn_all(self) -> Self:
        for s in self.suites:
            # `:` is fine in filenames; `/` would not be — sanitize defensively.
            log = self.tmpdir / f"{s.name.replace('/', '_')}.log"
            log.touch()
            self.log_paths[s.name] = log
            self.start_times[s.name] = time.time()
            # buffering=0: unbuffered file fd so the subprocess's writes hit
            # disk immediately and the dashboard's tail() sees them on the
            # next tick rather than waiting for python's userspace buffer.
            # Parenthesized context managers are nice here — and the open
            # file is only used to Popen-dup the fd, so closing it on
            # exit doesn't disturb the child.
            with open(log, "wb", buffering=0) as f:
                self.procs[s.name] = subprocess.Popen(
                    s.argv,
                    stdout=f,
                    stderr=subprocess.STDOUT,
                    cwd=REPO_ROOT,
                )
        return self

    def poll(self) -> list[str]:
        """Return names of suites that have completed since the last poll."""
        newly_done = []
        for name, proc in self.procs.items():
            if name in self.results:
                continue
            if (rc := proc.poll()) is not None:
                elapsed = time.time() - self.start_times[name]
                self.results[name] = (rc, elapsed)
                newly_done.append(name)
        return newly_done

    def all_done(self) -> bool:
        return len(self.results) == len(self.suites)

    def completed_count(self) -> int:
        return len(self.results)

    def cleanup(self) -> None:
        """Best-effort: terminate any still-running children, then nuke the
        tempdir. Called from both the normal-exit path and the signal
        handler, so it has to be idempotent and exception-safe."""
        for proc in self.procs.values():
            if proc.poll() is None:
                try:
                    proc.terminate()
                except ProcessLookupError:
                    pass
        shutil.rmtree(self.tmpdir, ignore_errors=True)


# --------------------------------------------------------------------------- #
# Dashboard rendering
# --------------------------------------------------------------------------- #
def _terminal_cols() -> int:
    try:
        return shutil.get_terminal_size((80, 24)).columns
    except OSError:
        return 80


def render_dashboard(runner: ParallelRunner) -> int:
    """Print the live dashboard. Returns the number of lines emitted so the
    next tick knows how many to clear via cursor-up + erase-to-end-of-screen."""
    cols = _terminal_cols()
    now = time.time()
    timestamp = time.strftime("%H:%M:%S")
    completed = runner.completed_count()
    total = len(runner.suites)

    # Header uses _dotfiles_common's announce styling (white-on-yellow,
    # bold, bracketed by spaces) so it stays distinct from pytest /
    # molecule output that has its own banner-like lines — without that
    # contrast the dashboard's "─── live ───" was indistinguishable from
    # one molecule scenario's separators against the previous suite's
    # scrollback. The X/N count gives at-a-glance progress.
    header_text = f"live · {timestamp} · {completed}/{total} suites complete"
    print(f"\n\x1b[1;37;43m {header_text} \x1b[0m")
    lines = 2  # the leading blank line + the header line

    for s in runner.suites:
        if s.name in runner.results:
            continue
        elapsed = int(now - runner.start_times[s.name])
        print(f"[{s.name} | {format_duration(elapsed)}]")
        lines += 1
        try:
            content = runner.log_paths[s.name].read_text(errors="replace")
            # Truncate to terminal width so wrap doesn't desync the
            # next-tick line-count math.
            tail = content.splitlines()[-TAIL_LINES:]
            for line in tail:
                print(line[:cols])
                lines += 1
        except (FileNotFoundError, OSError):
            pass
        print()  # blank line between suite blocks
        lines += 1

    return lines


def clear_dashboard(lines: int) -> None:
    if lines > 0:
        # Move cursor up `lines` rows, then erase from cursor to end of
        # display. Equivalent to `tput cuu N; tput ed` from the old bash
        # version.
        sys.stdout.write(f"\x1b[{lines}A\x1b[J")
        sys.stdout.flush()


def flush_completed(runner: ParallelRunner, newly_done: list[str]) -> None:
    """For each suite that finished since the last poll, print a PASS
    (yellow announce) or FAIL (red announce) banner followed by the suite's
    full buffered output. This becomes permanent scrollback as the
    dashboard redraws above it."""
    for name in newly_done:
        rc, elapsed = runner.results[name]
        status = "PASS" if rc == 0 else "FAIL"
        banner = f"{name} · {status} · {format_duration(elapsed)}"
        (announce if rc == 0 else announce_fail)(banner)
        try:
            sys.stdout.buffer.write(runner.log_paths[name].read_bytes())
            sys.stdout.flush()
        except (FileNotFoundError, OSError):
            pass


def print_summary(runner: ParallelRunner) -> int:
    """Print the per-suite summary. Returns 0 if all PASS, 1 otherwise."""
    announce("summary")
    max_name = max((len(s.name) for s in runner.suites), default=0)
    any_failed = False
    # Spawn order (matches dashboard order), not completion order — keeps
    # the layout stable run-to-run for at-a-glance reading.
    for s in runner.suites:
        rc, elapsed = runner.results[s.name]
        badge = ANSI_PASS_BADGE if rc == 0 else ANSI_FAIL_BADGE
        if rc != 0:
            any_failed = True
        print(f"  {s.name:<{max_name}}  {badge}  ({format_duration(elapsed)})")
    return 1 if any_failed else 0


# --------------------------------------------------------------------------- #
# Multi-suite parallel driver
# --------------------------------------------------------------------------- #
def run_multi(include_molecule: bool) -> int:
    suites = [PYTHON_SUITE, BASH_SUITE, LINT_SUITE]
    if include_molecule:
        # Serial homebrew image prep before any parallel spawn — concurrent
        # `docker build` / `docker tag` against the same `:local` tag would
        # race. Side effect: the parallel summary's molecule:homebrew
        # wall-clock reflects test work only, not image prep.
        if "homebrew" in MOLECULE_ROLES:
            info("preparing homebrew base image (serial; before parallel block)")
            prepare_homebrew_image()
        suites.extend(molecule_role_suite(role) for role in MOLECULE_ROLES)

    runner = ParallelRunner(suites).spawn_all()
    interactive = sys.stdout.isatty()

    def _signal_handler(_signum: int, _frame: object) -> None:
        # Ctrl+C / SIGTERM: tear down children, restore cursor, exit 130
        # (the conventional SIGINT exit code).
        runner.cleanup()
        if interactive:
            sys.stdout.write(ANSI_SHOW_CURSOR)
            sys.stdout.flush()
        sys.exit(130)

    signal.signal(signal.SIGINT, _signal_handler)
    signal.signal(signal.SIGTERM, _signal_handler)

    if interactive:
        sys.stdout.write(ANSI_HIDE_CURSOR)
        sys.stdout.flush()

    dashboard_lines = 0
    try:
        while True:
            if interactive:
                clear_dashboard(dashboard_lines)
                dashboard_lines = 0

            flush_completed(runner, runner.poll())

            if runner.all_done():
                break

            if interactive:
                dashboard_lines = render_dashboard(runner)
                sys.stdout.flush()

            time.sleep(TICK)
    finally:
        if interactive:
            sys.stdout.write(ANSI_SHOW_CURSOR)
            sys.stdout.flush()
        runner.cleanup()

    return print_summary(runner)


# --------------------------------------------------------------------------- #
# Dispatch
# --------------------------------------------------------------------------- #
USAGE = "usage: tests/run [python|bash|lint|molecule [role]|fast|all]"


def main(argv: list[str]) -> int:
    match argv:
        case []:
            return run_multi(include_molecule=True)
        case ["python", *_]:
            return run_single_suite(PYTHON_SUITE)
        case ["bash", *_]:
            return run_single_suite(BASH_SUITE)
        case ["lint", *_]:
            return run_lint_serial()
        case ["molecule"]:
            return run_molecule(None)
        case ["molecule", role, *_]:
            return run_molecule(role)
        case ["fast", *_]:
            return run_multi(include_molecule=False)
        case ["all", *_]:
            return run_multi(include_molecule=True)
        case _:
            print(USAGE, file=sys.stderr)
            return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
