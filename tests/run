#!/usr/bin/env bash
# Run the test suites.
#
#   ./tests/run             # python + bash (the fast suites)
#   ./tests/run python      # just pytest
#   ./tests/run bash        # just bats
#   ./tests/run molecule    # just molecule (per-role scenarios; needs docker)
#   ./tests/run all         # python + bash + molecule
#
# molecule is excluded from the bare-arg default because it requires docker
# and is slower than the python/bash suites. CI runs molecule as its own
# job — see .github/workflows/tests.yml.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

run_python() {
  echo "=== python ==="
  pytest tests/python -v
}

run_bash() {
  echo "=== bash ==="
  bats tests/bash
}

run_molecule() {
  echo "=== molecule ==="
  # Each scenario lives under roles/<role>/molecule/<scenario>/. molecule
  # discovers them via MOLECULE_GLOB and is invoked from the role dir so
  # `molecule test -s default` resolves correctly.
  local rc=0
  for role_dir in roles/dotfiles roles/apt roles/flatpak; do
    echo "--- molecule: ${role_dir} ---"
    (cd "${role_dir}" && molecule test -s default) || rc=$?
  done
  return $rc
}

case "${1:-default}" in
  python)   run_python ;;
  bash)     run_bash ;;
  molecule) run_molecule ;;
  default)  run_python; run_bash ;;
  all)      run_python; run_bash; run_molecule ;;
  *)        echo "usage: $0 [python|bash|molecule|default|all]" >&2; exit 2 ;;
esac
