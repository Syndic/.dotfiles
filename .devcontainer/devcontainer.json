{
  "name": "dotfiles",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      // Exact Python that macOS Xcode CLT ships — phase2.py runs under it on a
      // real bootstrap. Frozen: Renovate is blocked from bumping it (renovate.json).
      "version": "3.9.6",
      // Latest Python, for the Ansible tooling installed by post-create.sh.
      // Renovate keeps this current via the customManager in renovate.json.
      // renovate: datasource=python-version depName=python
      "additionalVersions": "3.14",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "jetmartin.bats",
        "gruntfuggly.todo-tree"
      ]
    }
  }
}
