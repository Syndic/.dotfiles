{
  "name": "dotfiles",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      // Exact Python that macOS Xcode CLT ships — phase2.py runs under it on a
      // real bootstrap. Frozen: Renovate is blocked from bumping it (renovate.json).
      "version": "3.9.6",
      // Latest Python, for the Ansible tooling installed by post-create.sh.
      // Renovate keeps this current via the customManager in renovate.json.
      // renovate: datasource=python-version depName=python
      "additionalVersions": "3.14",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      // Pin the Python extension (and its Testing UI) to the 3.9.6 primary:
      // pytest is installed only there, and the suite must exercise the code
      // on the same interpreter a real macOS bootstrap uses. The Python
      // Environments extension is turned off because its auto-discovery picks
      // the 3.13 Debian system python in this container and ignores
      // defaultInterpreterPath (verified — it does not honor the pin here);
      // classic interpreter management does honor it.
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python3",
        "python.useEnvironmentsExtension": false
      },
      "extensions": [
        "cnshenj.vscode-task-manager",
        "github.vscode-github-actions",
        "gruntfuggly.todo-tree",
        "jetmartin.bats",
        "ms-python.python",
        "ms-python.debugpy",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ryanluker.vscode-coverage-gutters",
        "timonwong.shellcheck"
      ]
    }
  }
}
