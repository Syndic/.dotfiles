{
  "name": "dotfiles",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    // No `python` feature: post-create.sh uses uv (see CLAUDE.md "Python 3.9 pin").
    "ghcr.io/devcontainers/features/git:1.3.8": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
    // Self-contained dockerd for molecule scenarios — docker-outside-of-docker
    // triggers an apt-module deserialization failure on the geerlingguy debian
    // images (likely namespace/cgroup interaction). moby: false picks
    // docker-ce because moby lacks a Debian trixie build.
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "moby": false
    }
  },
  // Worktree-aware git resolution — full rationale in CLAUDE.md
  // "Worktree git resolution".
  "initializeCommand": ".devcontainer/initialize.sh",
  "mounts": [
    // Docker follows the symlink host-side, so this static source resolves
    // to wherever the real git common dir lives without env vars.
    "source=${localWorkspaceFolder}/.devcontainer/.host-git-common,target=/host-git-common,type=bind",
    // Forward host ssh-agent for signed commits — see CLAUDE.md "Signed commits under devcontainer CLI".
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind"
  ],
  // Workspace at its real host path so the .git back-pointer lines up verbatim.
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "remoteUser": "vscode",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  // PATH for the three uv venvs post-create.sh builds. Keep in sync with that file.
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:/home/vscode/.venv-ansible/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "cnshenj.vscode-task-manager",
        "fnando.linter",
        "github.vscode-github-actions",
        "gruntfuggly.todo-tree",
        "jetmartin.bats",
        "ms-python.python",
        "ms-python.debugpy",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ryanluker.vscode-coverage-gutters",
        "timonwong.shellcheck"
      ],
      // Pin to ~/.venv (frozen 3.9.6 + pytest). useEnvironmentsExtension off
      // because that extension ignores defaultInterpreterPath here.
      "settings": {
        // Add "ansible" so role/play YAML (reclassified by redhat.ansible)
        // still gets yamllint diagnostics — .ansible-lint skips yaml rules.
        // See CLAUDE.md "Lint".
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.useEnvironmentsExtension": false,
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg"
      }
    }
  }
}
